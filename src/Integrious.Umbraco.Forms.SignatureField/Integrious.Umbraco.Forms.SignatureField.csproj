<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <RootNamespace>Integrious.Umbraco.Forms.SignatureField</RootNamespace>
    <AssemblyName>Integrious.Umbraco.Forms.SignatureField</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Puts Views at the package root, which buildTransitive depends on: its targets file copies
         from $(MSBuildThisFileDirectory)..\Views, and from an installed package that resolves to
         <package>/Views. Verified by installing the package into a scratch project. -->
    <ContentTargetFolders>.</ContentTargetFolders>

    <!-- wwwroot/App_Plugins ships as static web assets. Umbraco serves them from /App_Plugins/...
         rather than the default /_content/{AssemblyName}/..., which is what the base path override
         does. Replaces the old copy-into-the-site's-wwwroot build target. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <!-- The view here is an Umbraco Forms theme partial, shipped as a physical .cshtml and copied
         into the consuming site rather than compiled into this assembly. -->
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
  </PropertyGroup>

  <!-- Version, authors, licence, SourceLink and the Umbraco/Forms version ranges all come from
       Directory.Build.props. The previous Version/FileVersion/AssemblyVersion trio here was
       broken: Version read $(assemblyVersion) on the line *above* where AssemblyVersion was
       defined, so it evaluated to empty and the package built as 1.0.0 rather than 1.0.4. -->
  <PropertyGroup>
    <PackageId>Integrious.Umbraco.Forms.SignatureField</PackageId>
    <Title>Signature Field for Umbraco Forms</Title>
    <Description>Adds a Signature field type to Umbraco Forms, letting someone sign a form with a mouse, finger or stylus. The signature is captured on a canvas and stored on the record as a JPEG data URL, so it needs no file storage and renders anywhere the record does - including the back office entry view and printed output.</Description>
    <!-- The "umbraco-marketplace" tag is deliberately absent. It is the sole trigger for the
         Umbraco Marketplace listing this package, and we want a contained deployment and more
         testing first. To list it: add "umbraco-marketplace" to the tags below, re-enable the
         Marketplace sync step in .github/workflows/release.yml, and make sure
         umbraco-marketplace.json has reached the default branch - the Marketplace reads it from
         the root of the default branch, not from develop. -->
    <PackageTags>umbraco;umbraco-package;umbraco-forms;forms;signature;canvas;signature-pad</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReleaseNotes>See https://github.com/Integrious/UmbracoFormsSignatureField/blob/master/CHANGELOG.md</PackageReleaseNotes>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="$(UmbracoCmsVersion)" />
    <PackageReference Include="Umbraco.Forms.Core" Version="$(UmbracoFormsVersion)" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Build input only: the sass and webpack sources that generate wwwroot. ContentTargetFolders
         above sends Content to the package root, so without Pack="false" these ship to consumers -
         which they did. CopyToOutputDirectory metadata does NOT affect packing; only Pack does. -->
    <Content Update="App_Plugins_Src\**" Pack="false" CopyToOutputDirectory="Never" CopyToPublishDirectory="Never" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Views\**\*.cshtml" ExcludeFromSingleFile="true" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <UpToDateCheckInput Include="App_Plugins_Src\**\*.js" />
    <UpToDateCheckInput Include="App_Plugins_Src\**\*.scss" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Integrious.Umbraco.Forms.SignatureField.Tests" />
  </ItemGroup>

  <!--
    The front end assets under wwwroot are generated by `yarn build` at the repository root and are
    gitignored, so a clean checkout does not have them. Packing without them produces a package
    that installs cleanly and then does nothing - no canvas styling, no signature capture - which
    is the worst sort of failure, because nothing reports it.

    So fail the pack instead. CI installs dependencies and runs `yarn build` before packing.
  -->
  <Target Name="VerifySignatureFieldAssets" BeforeTargets="GenerateNuspec">
    <PropertyGroup>
      <!-- Forward slashes deliberately: this guard runs in CI on Linux, where a path built by
           string concatenation is not reliably normalised, and a backslash is a legal filename
           character. Forward slashes work on both. -->
      <_SigAssets>$(MSBuildProjectDirectory)/wwwroot/App_Plugins/UmbracoFormsSignatureField</_SigAssets>
    </PropertyGroup>
    <Error Condition="!Exists('$(_SigAssets)/BackOffice/Css/signature.css')"
           Text="signature.css is missing, so this package would ship without styles. Run `yarn install --immutable` then `yarn build` at the repository root before packing - the generated assets are gitignored." />
    <Error Condition="!Exists('$(_SigAssets)/FrontEnd/signatureField.js')"
           Text="signatureField.js is missing, so this package would ship without the signature capture script. Run `yarn install --immutable` then `yarn build` at the repository root before packing - the generated assets are gitignored." />
  </Target>

  <!--
    Rebuilds the front end assets on a local build, so that editing the scss or init.js and pressing
    build does the expected thing. Skipped when node_modules is absent - a restore-only CI step, or
    a machine with no Node - rather than failing; the pack guard above is what guarantees a
    *package* is never built without them.
  -->
  <Target Name="BuildSignatureFieldAssets" AfterTargets="PostBuildEvent"
          Condition="'$(SkipFrontEndBuild)' != 'true' AND Exists('$(MSBuildProjectDirectory)/../../node_modules')">
    <Exec Command="yarn run build" WorkingDirectory="$(MSBuildProjectDirectory)/../.." />
  </Target>

</Project>
