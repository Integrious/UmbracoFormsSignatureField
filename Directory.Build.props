<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <!-- Audit only what this repository chooses the version of. The Umbraco and Forms packages drag
         in a large transitive graph whose versions the consuming site decides, so auditing it would
         fail this build over advisories nobody here can act on - Microsoft.OpenApi being the
         current example. -->
    <NuGetAuditMode>direct</NuGetAuditMode>
  </PropertyGroup>

  <!-- The versions this package is built and tested against. Both are pinned to a 17.x range: the
       plugin uses a lot of Umbraco Forms surface (FieldType, record storage, theme views) and that
       surface already broke once, on the 13 to 17 port. Widen only once tested against the next
       major, not in anticipation of it.

       Overridable so CI can pin exact versions: -p:UmbracoFormsVersion=17.6.2 -->
  <PropertyGroup>
    <UmbracoCmsVersion Condition="'$(UmbracoCmsVersion)' == ''">[17.0.0, 18.0.0)</UmbracoCmsVersion>
    <UmbracoFormsVersion Condition="'$(UmbracoFormsVersion)' == ''">[17.0.0, 18.0.0)</UmbracoFormsVersion>
  </PropertyGroup>

  <!-- Shared package metadata. Version is overridden by the release workflow from the git tag. -->
  <PropertyGroup>
    <Version>1.1.0</Version>
    <Authors>Integrious</Authors>
    <Company>Integrious</Company>
    <Copyright>Copyright (c) 2026 Integrious</Copyright>
    <PackageProjectUrl>https://github.com/Integrious/UmbracoFormsSignatureField</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Integrious/UmbracoFormsSignatureField</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

</Project>
