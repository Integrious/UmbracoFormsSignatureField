<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContentTargetFolders>.</ContentTargetFolders>

    <!-- wwwroot/App_Plugins ships as static web assets. Umbraco serves them from /App_Plugins/...
         rather than the default /_content/{AssemblyName}/..., which is what the base path
         override does. Replaces the old copy-into-the-site's-wwwroot build target. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>

    <!-- Views here are an Umbraco Forms theme partial, shipped as a physical .cshtml and copied
         into the consuming site rather than compiled into this assembly. -->
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultRazorComponentItems>false</EnableDefaultRazorComponentItems>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>UmbracoFormsSignatureField</PackageId>
    <Product>UmbracoFormsSignatureField</Product>
    <Title>UmbracoFormsSignatureField</Title>
    <Description>...</Description>
    <PackageTags>umbraco plugin package</PackageTags>
    <AssemblyName>integrious.umbraco.forms.signaturefield</AssemblyName>
    <RootNamespace>Integrious.Umbraco.Forms.SignatureField</RootNamespace>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <Version>$(VersionPrefix)$(assemblyVersion)</Version>
    <FileVersion>$(assemblyVersion)</FileVersion>
    <AssemblyVersion>1.0.4</AssemblyVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="17.8.0" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="17.8.0" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="17.8.0" />
    <PackageReference Include="Umbraco.Forms.Core" Version="17.6.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <!-- App_Plugins now lives under wwwroot and is handled by the Razor SDK as static web assets,
         so it no longer needs listing here. App_Plugins_Src is build input only - it is the sass
         and webpack source - so it stays excluded from the output. -->
    <Content Include="App_Plugins_Src\UmbracoFormsSignatureField\BackOffice\Scss\signature.scss">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Plugins_Src\UmbracoFormsSignatureField\FrontEnd\Js\init.js">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <UpToDateCheckInput Include="App_Plugins_Src\UmbracoFormsSignatureField\**/*.js" />
    <UpToDateCheckInput Include="App_Plugins_Src\UmbracoFormsSignatureField\**/*.scss" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="yarn run build" />
  </Target>
</Project>
