<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ContentTargetFolders>.</ContentTargetFolders>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>UmbracoFormsSignatureField</PackageId>
    <Product>UmbracoFormsSignatureField</Product>
    <Title>UmbracoFormsSignatureField</Title>
    <Description>...</Description>
    <PackageTags>umbraco plugin package</PackageTags>
    <AssemblyName>integrious.umbraco.forms.signaturefield</AssemblyName>
    <RootNamespace>Integrious.Umbraco.Forms.SignatureField</RootNamespace>
    <RunPostBuildEvent>Always</RunPostBuildEvent>
    <Version>$(VersionPrefix)$(assemblyVersion)</Version>
    <FileVersion>$(assemblyVersion)</FileVersion>
    <AssemblyVersion>1.0.4</AssemblyVersion>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Umbraco.Cms.Core" Version="13.6.0" />
    <PackageReference Include="Umbraco.Cms.Infrastructure" Version="13.6.0" />
    <PackageReference Include="Umbraco.Cms.Web.Website" Version="13.6.0" />
    <PackageReference Include="Umbraco.Cms.Web.BackOffice" Version="13.6.0" />
    <PackageReference Include="Umbraco.Forms.Core" Version="13.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="buildTransitive\**" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="App_Plugins\**" />
    <EmbeddedResource Remove="App_Plugins\**" />
    <None Remove="App_Plugins\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="App_Plugins\UmbracoFormsSignatureField\BackOffice\Common\FieldTypes\signature.html">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="App_Plugins\UmbracoFormsSignatureField\BackOffice\Common\RenderTypes\signature.html">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </Content>
    <Content Include="App_Plugins_Src\UmbracoFormsSignatureField\BackOffice\Scss\signature.scss">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
    <Content Include="App_Plugins_Src\UmbracoFormsSignatureField\FrontEnd\Js\init.js">
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  
  <ItemGroup>
    <UpToDateCheckInput Include="App_Plugins_Src\UmbracoFormsSignatureField\**/*.js" />
    <UpToDateCheckInput Include="App_Plugins_Src\UmbracoFormsSignatureField\**/*.scss" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="yarn run build" />
  </Target>
</Project>
